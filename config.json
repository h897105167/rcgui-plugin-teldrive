{
  "id": "teldrive",
  "name": { "zh": "Teldrive", "en": "Teldrive" },
  "version": "0.4.1",
  "entry": "main.wasm",
  "description": {
    "zh": "部署 teldrive、登录 Telegram、建频道与机器人、建远程并挂载，可原地升级 teldrive",
    "en": "Deploy teldrive, sign in to Telegram, create a channel and bots, add and mount the remote, and upgrade teldrive in place"
  },
  "author": { "zh": "RCGUI", "en": "RCGUI" },
  "tags": { "zh": ["teldrive", "网盘", "部署"], "en": ["teldrive", "cloud", "deploy"] },
  "capabilities": ["kv", "fs", "http", "proc", "net", "rclone", "env"],
  "min_gui_version": "0.3.0",
  "platform": "windows",
  "plugin_setting": {
    "version": 2,
    "summary": { "zh": "部署、登录、频道与机器人、挂载、升级", "en": "Deploy, sign-in, channel and bots, mount, upgrade" },
    "pages": [
      { "id": "deployment", "label": { "zh": "部署", "en": "Deployment" } },
      { "id": "telegram", "label": { "zh": "Telegram 登录", "en": "Telegram sign-in" } },
      { "id": "channel", "label": { "zh": "频道与机器人", "en": "Channel and bots" } },
      { "id": "remote", "label": { "zh": "远程挂载", "en": "Remote and mount" } },
      { "id": "maintenance", "label": { "zh": "维护", "en": "Maintenance" } }
    ],
    "controls": [
      { "kind": "status", "key": "run", "label": { "zh": "当前状态", "en": "Status" }, "lamp": true },
      { "kind": "progress", "key": "progress" },
      { "kind": "checks", "key": "checks", "label": { "zh": "检查项", "en": "Checks" }, "text": { "zh": "尚未校验", "en": "Not checked yet" } },

      { "kind": "group", "key": "g_dir", "label": { "zh": "数据目录与端口", "en": "Data directory and ports" }, "page": "deployment" },
      {
        "kind": "field",
        "key": "root",
        "label": { "zh": "数据目录", "en": "Data directory" },
        "field": "path",
        "placeholder": { "zh": "留空 = RCGUI 数据目录\\plugins\\teldrive", "en": "Empty = <RCGUI data>\\plugins\\teldrive" },
        "dialog_title": { "zh": "选择 teldrive 数据目录", "en": "Choose the teldrive data directory" },
        "page": "deployment"
      },
      {
        "kind": "field",
        "key": "port",
        "label": { "zh": "HTTP 端口", "en": "HTTP port" },
        "field": "number",
        "default": "8080",
        "page": "deployment"
      },
      { "kind": "hint", "key": "hint_svc", "label": { "zh": "说明", "en": "Note" }, "text": { "zh": "teldrive 的 HTTP 服务只监听 127.0.0.1", "en": "teldrive's HTTP service listens on 127.0.0.1 only" }, "page": "deployment" },

      { "kind": "group", "key": "g_db", "label": { "zh": "数据库", "en": "Database" }, "page": "deployment" },
      {
        "kind": "field",
        "key": "db_mode",
        "label": { "zh": "数据库方式", "en": "Database" },
        "field": "select",
        "options": [
          { "value": "portable", "label": { "zh": "便携数据库（推荐）", "en": "Portable (recommended)" } },
          { "value": "existing", "label": { "zh": "已有数据库", "en": "Existing server" } },
          { "value": "docker", "label": { "zh": "Docker 容器", "en": "Docker container" } },
          { "value": "auto", "label": { "zh": "自动", "en": "Automatic" } }
        ],
        "default": "portable",
        "page": "deployment"
      },
      {
        "kind": "field",
        "key": "db_url",
        "label": { "zh": "连接串", "en": "Connection string" },
        "field": "text",
        "placeholder": { "zh": "postgres://postgres:密码@127.0.0.1:5432/teldrive?sslmode=disable", "en": "postgres://postgres:secret@127.0.0.1:5432/teldrive?sslmode=disable" },
        "page": "deployment"
      },
      {
        "kind": "field",
        "key": "pg_port",
        "label": { "zh": "数据库端口", "en": "Database port" },
        "field": "number",
        "default": "5432",
        "page": "deployment"
      },
      { "kind": "hint", "key": "hint_db", "label": { "zh": "数据库选择", "en": "Database choice" }, "text": { "zh": "默认「便携数据库」：自动下载 22 MB 的 PostgreSQL 放进数据目录，不需要事先安装。已经有 PostgreSQL（本机、服务器或云数据库）时改成「已有数据库」并填上面的连接串", "en": "Portable (default) downloads a 22 MB PostgreSQL into the data directory, so nothing needs installing first. Choose Existing server when PostgreSQL already runs somewhere, and fill the connection string above" }, "page": "deployment" },
      {
        "kind": "field",
        "key": "deployed_version",
        "label": { "zh": "已部署版本", "en": "Deployed version" },
        "field": "text",
        "enabled": false,
        "page": "deployment"
      },
      { "kind": "hint", "key": "hint_portable", "label": { "zh": "便携数据库说明", "en": "About the portable database" }, "text": { "zh": "下载 22 MB，解压后约 97 MB", "en": "Downloads 22 MB, extracts to about 97 MB" }, "page": "deployment" },
      {
        "kind": "action",
        "key": "deploy",
        "label": { "zh": "一键部署", "en": "Deploy" },
        "style": "primary",
        "line": "deploy-actions",
        "page": "deployment"
      },
      {
        "kind": "action",
        "key": "open_dir",
        "label": { "zh": "打开目录", "en": "Open folder" },
        "line": "deploy-actions",
        "page": "deployment"
      },

      { "kind": "group", "key": "g_svc", "label": { "zh": "服务", "en": "Service" }, "page": "deployment" },
      {
        "kind": "action",
        "key": "start",
        "label": { "zh": "启动", "en": "Start" },
        "style": "primary",
        "line": "svc-actions",
        "page": "deployment"
      },
      {
        "kind": "action",
        "key": "stop",
        "label": { "zh": "停止", "en": "Stop" },
        "style": "danger",
        "line": "svc-actions",
        "page": "deployment"
      },

      { "kind": "group", "key": "g_login", "label": { "zh": "扫码登录", "en": "Sign in by QR" }, "page": "telegram" },
      {
        "kind": "action",
        "key": "qr_start",
        "label": { "zh": "扫码登录", "en": "Show QR code" },
        "style": "primary",
        "line": "qr-actions",
        "page": "telegram"
      },
      {
        "kind": "action",
        "key": "qr_poll",
        "label": { "zh": "检查扫码结果", "en": "Check scan" },
        "line": "qr-actions",
        "page": "telegram"
      },
      { "kind": "hint", "key": "hint_qr", "label": { "zh": "扫码", "en": "QR code" }, "text": { "zh": "点「扫码登录」后二维码显示在下方：手机 Telegram → 设置 → 设备 → 链接桌面设备。未确认时点「检查扫码结果」换新码；下面的手机号登录同样可用", "en": "Press Show QR code and the code appears below: on the phone use Telegram > Settings > Devices > Link Desktop Device. While unconfirmed, Check scan issues a fresh code. Phone sign-in below works too" }, "page": "telegram" },
      { "kind": "image", "key": "qr", "label": { "zh": "扫这个码", "en": "Scan this" }, "page": "telegram" },

      { "kind": "group", "key": "g_login_phone", "label": { "zh": "手机号登录", "en": "Sign in by phone" }, "page": "telegram" },
      {
        "kind": "field",
        "key": "phone",
        "label": { "zh": "手机号", "en": "Phone number" },
        "field": "text",
        "placeholder": { "zh": "+8613800138000", "en": "+8613800138000" },
        "page": "telegram"
      },
      {
        "kind": "field",
        "key": "code",
        "label": { "zh": "验证码", "en": "Login code" },
        "field": "text",
        "page": "telegram"
      },
      {
        "kind": "field",
        "key": "password",
        "label": { "zh": "两步验证密码", "en": "Two-step password" },
        "field": "password",
        "placeholder": { "zh": "仅开启两步验证时需要", "en": "Only with two-step verification" },
        "page": "telegram"
      },
      {
        "kind": "action",
        "key": "login_start",
        "label": { "zh": "发送验证码", "en": "Send code" },
        "line": "login-actions",
        "page": "telegram"
      },
      {
        "kind": "action",
        "key": "login_verify",
        "label": { "zh": "提交验证码", "en": "Submit code" },
        "line": "login-actions",
        "page": "telegram"
      },
      {
        "kind": "action",
        "key": "login_password",
        "label": { "zh": "提交两步密码", "en": "Submit password" },
        "line": "login-actions",
        "page": "telegram"
      },
      { "kind": "hint", "key": "hint_login", "label": { "zh": "说明", "en": "Note" }, "text": { "zh": "手机号用国际格式，例如 +8613800138000；验证码发到该账号的 Telegram 与短信", "en": "Use the international phone format, e.g. +8613800138000. The code arrives in Telegram and by SMS" }, "page": "telegram" },
      {
        "kind": "action",
        "key": "logout",
        "label": { "zh": "退出登录", "en": "Sign out" },
        "line": "account-actions",
        "page": "telegram"
      },

      { "kind": "group", "key": "g_channel", "label": { "zh": "频道", "en": "Channel" }, "page": "channel" },
      {
        "kind": "field",
        "key": "channel_name",
        "label": { "zh": "新频道名", "en": "New channel name" },
        "field": "text",
        "placeholder": { "zh": "例如 my-drive", "en": "e.g. my-drive" },
        "page": "channel"
      },
      {
        "kind": "action",
        "key": "channel_create",
        "label": { "zh": "创建频道", "en": "Create channel" },
        "style": "primary",
        "line": "ch-actions",
        "page": "channel"
      },
      {
        "kind": "field",
        "key": "channel_id",
        "label": { "zh": "已有频道", "en": "Existing channel" },
        "field": "select",
        "dynamic": true,
        "placeholder": { "zh": "点「刷新频道」列出账号下的频道", "en": "Press Refresh channels to list them" },
        "page": "channel"
      },
      {
        "kind": "action",
        "key": "channels_refresh",
        "label": { "zh": "刷新频道", "en": "Refresh channels" },
        "line": "ch-actions",
        "page": "channel"
      },
      {
        "kind": "action",
        "key": "channel_use",
        "label": { "zh": "使用该频道", "en": "Use this channel" },
        "line": "ch-actions",
        "page": "channel"
      },

      { "kind": "group", "key": "g_bot", "label": { "zh": "机器人", "en": "Bots" }, "page": "channel" },
      {
        "kind": "field",
        "key": "tokens",
        "label": { "zh": "机器人 token", "en": "Bot tokens" },
        "field": "multiline",
        "placeholder": { "zh": "每行一个，最多 200 个", "en": "One per line, up to 200" },
        "page": "channel"
      },
      { "kind": "hint", "key": "hint_bot", "label": { "zh": "说明", "en": "Note" }, "text": { "zh": "机器人先在 @BotFather 里创建：发 /newbot 取名，复制 token 后每行一个粘贴到上面", "en": "Create bots in @BotFather first: send /newbot, name it, copy the token, then paste one per line above" }, "page": "channel" },
      {
        "kind": "action",
        "key": "bot_add",
        "label": { "zh": "添加机器人", "en": "Add bots" },
        "line": "ch-actions",
        "page": "channel"
      },
      { "kind": "hint", "key": "hint_bots", "label": { "zh": "机器人清单", "en": "Bot list" }, "text": { "zh": "尚未拉取，点「刷新机器人」列出账号下的机器人", "en": "Not loaded yet — press Refresh bots to list them" }, "page": "channel" },
      {
        "kind": "action",
        "key": "bots_refresh",
        "label": { "zh": "刷新机器人", "en": "Refresh bots" },
        "line": "ch-actions",
        "page": "channel"
      },
      {
        "kind": "field",
        "key": "bot_id",
        "label": { "zh": "删除哪一台", "en": "Remove which bot" },
        "field": "select",
        "dynamic": true,
        "placeholder": { "zh": "先点「刷新机器人」", "en": "Refresh bots first" },
        "page": "channel"
      },
      {
        "kind": "action",
        "key": "bot_delete",
        "label": { "zh": "删除机器人", "en": "Remove bot" },
        "style": "danger",
        "line": "ch-actions",
        "page": "channel"
      },
      { "kind": "hint", "key": "hint_bot_delete", "label": { "zh": "说明", "en": "Note" }, "text": { "zh": "只从 teldrive 的机器人池里移除，Telegram 上的机器人本身不受影响", "en": "Removes it from teldrive's bot pool only; the bot in Telegram is untouched" }, "page": "channel" },

      { "kind": "group", "key": "g_remote", "label": { "zh": "远程与挂载", "en": "Remote and mount" }, "page": "remote" },
      {
        "kind": "field",
        "key": "name",
        "label": { "zh": "远程名", "en": "Remote name" },
        "field": "text",
        "default": "teldrive",
        "page": "remote"
      },
      {
        "kind": "field",
        "key": "drive",
        "label": { "zh": "盘符", "en": "Drive letter" },
        "field": "text",
        "default": "T:",
        "placeholder": { "zh": "T:", "en": "T:" },
        "page": "remote"
      },
      {
        "kind": "action",
        "key": "remote_create",
        "label": { "zh": "创建远程", "en": "Add remote" },
        "style": "primary",
        "line": "remote-actions",
        "page": "remote"
      },
      {
        "kind": "action",
        "key": "mount",
        "label": { "zh": "挂载", "en": "Mount" },
        "style": "primary",
        "line": "remote-actions",
        "page": "remote"
      },
      {
        "kind": "action",
        "key": "unmount",
        "label": { "zh": "卸载", "en": "Unmount" },
        "style": "danger",
        "line": "remote-actions",
        "page": "remote"
      },

      { "kind": "hint", "key": "hint_remote", "label": { "zh": "前置条件", "en": "Prerequisite" }, "text": { "zh": "teldrive 是 tgdrive 的 rclone 分支里的后端，官方 rclone 没有。创建前插件会先问 rclone 要后端列表，缺 teldrive 时不会硬建，而是告诉你怎么办", "en": "teldrive is a backend of the tgdrive rclone fork; upstream rclone has no such backend. Before creating, the plugin asks rclone for its backend list and, when teldrive is missing, explains the options instead of failing blind" }, "page": "remote" },

      { "kind": "group", "key": "g_proxy", "label": { "zh": "传输代理", "en": "Transfer proxy" }, "page": "remote" },
      {
        "kind": "field",
        "key": "proxy",
        "label": { "zh": "代理地址", "en": "Proxy URL" },
        "field": "text",
        "placeholder": { "zh": "http://127.0.0.1:7890 或 socks5://…，留空为直连", "en": "http://127.0.0.1:7890 or socks5://…; empty means direct" },
        "page": "remote"
      },
      { "kind": "hint", "key": "hint_proxy", "label": { "zh": "说明", "en": "Note" }, "text": { "zh": "写入 config.yaml 的 telegram.proxy，只影响 teldrive 与 Telegram 之间的传输；点「应用代理」会重启服务，数据库不受影响", "en": "Written to telegram.proxy in config.yaml and affects only teldrive's traffic to Telegram. Apply proxy restarts the service; the database is untouched" }, "page": "remote" },
      {
        "kind": "action",
        "key": "proxy_apply",
        "label": { "zh": "应用代理", "en": "Apply proxy" },
        "line": "proxy-actions",
        "page": "remote"
      },

      { "kind": "group", "key": "g_upd", "label": { "zh": "版本与升级", "en": "Version and updates" }, "page": "maintenance" },
      {
        "kind": "field",
        "key": "cur_version",
        "label": { "zh": "当前版本", "en": "Current version" },
        "field": "text",
        "enabled": false,
        "page": "maintenance"
      },
      {
        "kind": "field",
        "key": "latest_version",
        "label": { "zh": "最新版本", "en": "Latest version" },
        "field": "text",
        "enabled": false,
        "page": "maintenance"
      },
      { "kind": "hint", "key": "hint_upd", "label": { "zh": "升级说明", "en": "About upgrades" }, "text": { "zh": "只从官方 GitHub release 下载与校验，只替换本插件安装的 teldrive.exe；数据库、config.yaml、session 与机器人 token 都不动。上游没有提供可信校验值时不自动安装。同一个目录里由你自己启动的 teldrive 不会被结束", "en": "Downloads and verifies from the official GitHub release only, and replaces just the teldrive.exe this plugin installed. The database, config.yaml, session and bot tokens stay untouched. Nothing is installed when upstream ships no trusted checksum. A teldrive you started yourself in the same folder is never killed" }, "page": "maintenance" },
      {
        "kind": "action",
        "key": "check_update",
        "label": { "zh": "检查新版本", "en": "Check for updates" },
        "line": "upd-actions",
        "page": "maintenance"
      },
      {
        "kind": "action",
        "key": "update",
        "label": { "zh": "升级 teldrive", "en": "Upgrade teldrive" },
        "style": "primary",
        "line": "upd-actions",
        "page": "maintenance"
      }
    ]
  }
}
